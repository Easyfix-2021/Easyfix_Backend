mxCell><mxCell id="easyfix-dfd-level-1-platform-edge-29" value="enriched lifecycle&lt;br&gt;payload + retry" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=1;strokeColor=#E0930F;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;fontFamily=Arial;fontSize=12;fontColor=#363B41;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-event" target="x-webhook"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1980" y="1125"/><mxPoint x="1980" y="930"/></Array></mxGeometry></mxCell><mxCell id="easyfix-dfd-level-1-platform-note" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Scope note:&lt;/b&gt; Performance boundaries shown: bounded client storage and retries, rate/body limits at the API, finite DB pool/queue, capped location history, bounded push fan-out, and post-state-change delivery. Provider code/configuration is not proof of active production credentials.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#E4E7EA;fillColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#5C636B;align=left;spacing=8;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="1568" width="2340" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="easyfix-dfd-level-2-technician-job-lifecycle" name="Level 2 - Technician Lifecycle"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="easyfix-dfd-level-2-technician-job-lifecycle-title" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:26px&quot;&gt;&lt;b&gt;EasyFix Data Flow Diagram · Level 2 Technician Job Lifecycle&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5C636B&quot;&gt;Editable screen-to-process trace for the highest-value mobile flow · Static worktree audit · 11 Aug 2026&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#171B1F;spacing=0;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="2340" height="80" as="geometry"/></mxCell><mxCell id="b-app" value="TECHNICIAN APP · screens and account-scoped transport" style="rounded=1;arcSize=8;fillColor=#F4F6F7;fillOpacity=25;strokeColor=#9AA1A9;strokeWidth=2;dashed=1;dashPattern=8 6;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#9AA1A9;spacingTop=8;spacingLeft=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="135" width="2340" height="390" as="geometry"/></mxCell><mxCell id="b-be" value="UNIFIED BACKEND · mobile API and authoritative transition logic" style="rounded=1;arcSize=8;fillColor=#FBF0F1;fillOpacity=25;strokeColor=#C42430;strokeWidth=2;dashed=1;dashPattern=8 6;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#C42430;spacingTop=8;spacingLeft=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="565" width="2340" height="370" as="geometry"/></mxCell><mxCell id="b-bottom" value="DURABLE STORES &amp; DELIVERY TARGETS" style="rounded=1;arcSize=8;fillColor=#E2F5EA;fillOpacity=25;strokeColor=#1B9E5A;strokeWidth=2;dashed=1;dashPattern=8 6;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#1B9E5A;spacingTop=8;spacingLeft=12;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="975" width="2340" height="360" as="geometry"/></mxCell><mxCell id="a1" value="&lt;div&gt;&lt;b&gt;Login &amp; registration&lt;/b&gt;&lt;br&gt;Mobile + OTP&lt;br&gt;Language / pincode / referral&lt;br&gt;Profile, KYC &amp; lifecycle gate&lt;br&gt;JWT persisted only after verify&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#171B1F;spacing=8;rounded=1;arcSize=12;fillColor=#FBF0F1;strokeColor=#C42430;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="340" height="205" as="geometry"/></mxCell><mxCell id="a2" value="&lt;div&gt;&lt;b&gt;Dashboard &amp; job offers&lt;/b&gt;&lt;br&gt;Cached aggregated dashboard&lt;br&gt;FCM deep-link / offer alert&lt;br&gt;Open offers → detail&lt;br&gt;Accept or reject online&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#171B1F;spacing=8;rounded=1;arcSize=12;fillColor=#FBF0F1;strokeColor=#C42430;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="340" height="205" as="geometry"/></mxCell><mxCell id="a3" value="&lt;div&gt;&lt;b&gt;Scheduled job / reached&lt;/b&gt;&lt;br&gt;Job detail + masked customer call&lt;br&gt;ETA / navigation&lt;br&gt;Upload reached selfie&lt;br&gt;Resend customer check-in PIN&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#171B1F;spacing=8;rounded=1;arcSize=12;fillColor=#FBF0F1;strokeColor=#C42430;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="340" height="205" as="geometry"/></mxCell><mxCell id="a4" value="&lt;div&gt;&lt;b&gt;Check-in &amp; start work&lt;/b&gt;&lt;br&gt;Customer PIN verification&lt;br&gt;Optional GPS stamp&lt;br&gt;Status → IN_PROGRESS&lt;br&gt;Start account/job-bound location task&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#171B1F;spacing=8;rounded=1;arcSize=12;fillColor=#FBF0F1;strokeColor=#C42430;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="340" height="205" as="geometry"/></mxCell><mxCell id="a5" value="&lt;div&gt;&lt;b&gt;Estimate &amp; work progress&lt;/b&gt;&lt;br&gt;Rate card + quotation lines&lt;br&gt;Images + questionnaire&lt;br&gt;Send for approval&lt;br&gt;Continue / reschedule / cancel&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;vertica