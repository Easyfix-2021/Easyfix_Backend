# ────────────────────────────────────────────────────────────────
# EasyFix_Backend — Environment Template
# Copy to .env and fill in values. .env is gitignored.
# ────────────────────────────────────────────────────────────────

# Server
PORT=5100
NODE_ENV=development
LOG_LEVEL=debug
# LOG_OPTIONS — dedicated noise gate for CORS preflight lines.
# `middleware/http-log.js` skips logging successful OPTIONS requests by
# default because every cross-origin GET/POST from CRM_UI / Client_UI
# triggers one, and at LOG_LEVEL=debug they used to drown out the real
# request log. Flip to `true` only when chasing a CORS bug — then each
# preflight prints `<status> OPTIONS <path> (<ms> ms)`. Leave unset /
# `false` everywhere else.
LOG_OPTIONS=false

# Profile Update Dev URL (2026-06-11)
# When `true`, exposes GET /api/admin/easyfixers/:id/profile-update-link/dev-url
# which mints the profile-update JWT + URL without sending WhatsApp — the
# row-action menu's "Copy Dev URL" item depends on this. Auto-enabled when
# NODE_ENV !== 'production'; this flag is the explicit prod override for
# staging deploys that intentionally run as prod.
# Set to `false` (or unset) in true production. `true` is the right default
# for local dev / staging.
ENABLE_DEV__PROFILE_URL=true

# Database (shared with legacy services — DO NOT alter schema)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=easyfix_core
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT=30000
# ─── Advanced pool tuning (db.js::createPool) ────────────────────────────
# Defaults baked into the code work fine for the local dev box; override
# only when /api/health/db shows the pool saturating under real load.
#
# DB_QUEUE_LIMIT — max in-flight requests parked waiting for a free
#   connection before mysql2 starts rejecting with "Queue limit reached".
#   Code default 50; the project .env raises to 100 for staging/prod
#   under bursty Webhook + Excel-upload traffic. 0 means unlimited
#   (don't — masks runaway query loops). The pool emits an `enqueue`
#   event each time a request waits; db.js logs a warn once per burst
#   and every 25th occurrence so a saturated pool surfaces in logs.
# DB_MAX_IDLE — cap on idle connections kept open between bursts.
#   Code default 10; raise to match DB_CONNECTION_LIMIT (20) when the
#   workload is steady so we don't pay reconnect cost on every quiet
#   second. Lower it on memory-constrained nodes to free MySQL slots.
# DB_IDLE_TIMEOUT — ms an idle connection lingers before mysql2 closes
#   it. Default 60_000 (60s). Keep above the MySQL `wait_timeout` minus
#   a safety margin so we close on our side first; otherwise the server
#   rips connections out from under the pool and the next acquire fails
#   with "Connection lost: read ECONNRESET".
DB_QUEUE_LIMIT=100
DB_MAX_IDLE=20
DB_IDLE_TIMEOUT=60000

# CORS — allowed frontend origins (comma-separated per var)
CRM_URL=http://localhost:5180
CLIENT_URL=http://localhost:5181
# Easyfix_Technician_Mobile_Application — covers the web-preview port + the
# Capacitor/Ionic native shells. Native React Native fetches don't send an
# Origin header so they're already allow-by-default; this var is only for
# the in-browser surfaces. Override per env, e.g.:
#   MOBILE_APP_URL=https://mobile.easyfix.in
#   MOBILE_APP_URL=http://localhost:8081,capacitor://localhost  (Expo + iOS shell)
MOBILE_APP_URL=http://localhost:5182,capacitor://localhost,ionic://localhost
# BE's own host(s) — for Swagger UI Quick Login + any same-origin fetch
# that sends an Origin header. Defaults to http://localhost:${PORT}
# plus http://127.0.0.1:${PORT} (handled in cors.js code, not here).
# Override on staging/prod when the BE is reachable under additional
# hostnames not covered by the auto-detect, e.g.:
#   SELF_URL=https://qa.backend.easyfix.in
# SELF_URL=

# JWT (used in Step 2)
JWT_SECRET=
JWT_EXPIRY=30d

# File uploads (used in Step 10)
UPLOAD_ROOT_PATH=/var/www/html/easydoc
UPLOAD_EASYFIXER_DOCS=/var/www/html/easydoc/easyfixer_documents
UPLOAD_JOB_FILES=/var/www/html/easydoc/upload_jobs
UPLOAD_INVOICES=/var/www/html/easydoc/client_invoice
FILE_BASE_URL=/easydoc

# ─── S3 storage for Job Images ───────────────────────────────────────────
# When S3_BUCKET_NAME is set, Job Images uploaded via the Book-New-Call
# flow land at s3://<S3_BUCKET_NAME>/Job_Images/<jobId>_<seq>. Read
# paths check S3 first then fall back to UPLOAD_JOB_FILES on the local
# filesystem (legacy parity). Leave blank to disable S3 entirely —
# uploads go straight to the local path with no S3 round trip.
#
# Credentials: standard AWS SDK chain. On Container Apps / EC2 / ECS,
# attach an IAM role with s3:PutObject + s3:GetObject + s3:HeadObject
# on the bucket and omit the static keys. Locally, set
# AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Presigned URL TTL for image reads — default 300s. Keep short; the
# frontend re-mints on each render anyway.
S3_PRESIGN_TTL_SEC=300
# Lazy migration of legacy local-filesystem images into S3.
#   false (default) → leave existing /upload_jobs/<file> rows alone.
#   true            → on every image read, if the row still has a bare
#                     filename, the backend uploads it to S3 at
#                     Job_Images/<jobId>_<seq>, UPDATEs the DB row to
#                     point at the new key, AND deletes the local file
#                     for cleanup. Pay-per-view migration; S3 becomes
#                     the only copy after success.
S3_MIGRATE_LEGACY_TO_S3=false

# Test-mode recipient overrides (dev/QA only — leave blank in production).
# When set, every outbound message is redirected to these values regardless of
# the real recipient. Applied at the last point inside each notification
# service, so no call path can bypass them.
TEST_EMAILS=
TEST_MOBILE=
TEST_FCM_TOKEN=
NOTIFICATIONS_DISABLE=false

# QA / dev convenience — set to "true" to use deterministic OTPs for login:
#   Email login → OTP = 2468 (any address)
#   Mobile login → OTP = last 4 digits of dialed number
# Lets you log in without an SMS/email gateway. NEVER set on production —
# it would be a complete auth bypass. See utils/otp.js::resolveLoginOtp().
QA_DETERMINISTIC_OTP=true

# Auto-assignment (used in Step 9)
MAX_TRAVEL_DISTANCE_KM=15
MAX_CONCURRENT_JOBS=5
WEIGHT_DISTANCE=0.35
WEIGHT_WORKLOAD=0.30
WEIGHT_RATING=0.20
WEIGHT_COMPLETION=0.15

# Notifications (used in Step 11)
# ─── Email: Microsoft Graph API (active 2026-04-20+) ──────────────────────
# App registration needs Mail.Send (application permission), admin-consented.
# Sender mailbox must be licensed in the tenant.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=ithelpdesk@easyfix.in
# ─── Email: Gmail SMTP (ARCHIVED — un-comment if reverting) ───────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMS_API_URL=http://smscountry.com/SMSCwebservice_Bulk.aspx
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=EsyFix

# ─── OTP delivery (services/otp-delivery.service.js) ────────────────────
# Login OTP fan-out for mobile identifiers. Email identifiers go through
# Microsoft Graph only; these two knobs apply to the mobile path.
#
# WHATSAPP_OTP_TEMPLATE — name of the pre-approved WhatsApp template the
#   WA send call references. Gallabox resolves templates by name (no id).
#   Default `login_otp` matches the production template; override per
#   env when a tenant uses a different approved name. If the named
#   template is missing/unapproved, the WA send fails, the SMS fallback
#   kicks in and the user still gets the OTP — graceful.
WHATSAPP_OTP_TEMPLATE=login_otp
# OTP_DUAL_CHANNEL_MOBILE — when `true`, mobile OTPs go out BOTH on
#   WhatsApp and SMS in parallel (Promise.all). When `false` / unset,
#   we send WhatsApp first and only fall back to SMS if the WA send
#   throws. Why dual exists: Gallabox returns "ACCEPTED" the moment it
#   queues the message but exposes no delivery-status API, so a
#   template that's registered in Gallabox but not yet Meta-approved
#   looks "delivered" while the user sees nothing — and pure fallback
#   never runs. Set `true` until WhatsApp template delivery is
#   confirmed reliable, then flip off to halve outbound SMS cost.
OTP_DUAL_CHANNEL_MOBILE=true

GALLABOX_URL=https://server.gallabox.com/devapi/messages/whatsapp
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID=
# Shared secret for the inbound WhatsApp webhook (Gallabox → us). REQUIRED for
# the conversational order-confirmation flow — the webhook fails closed when
# unset. Configure the same value as a custom header (x-webhook-secret) OR
# ?secret= on the Gallabox webhook pointing at POST /api/webhook/whatsapp.
# The opener template name is hardcoded as 'confirm_order_flow' in
# services/whatsapp-conversation.service.js (same pattern as 'confirm_order'
# in the magic-link FORM flow). Gallabox resolves templates by name — no id.
GALLABOX_WEBHOOK_SECRET=

# ─── AI NLU (conversational WhatsApp free-text understanding) ────────────
# OpenAI (gpt-4o-mini) parses free-text date/time + intent in the chat flow.
# Called via fetch in services/ai.service.js (no SDK dependency). Gated:
# AI_CONVERSATION_ENABLED must be 'true' AND OPENAI_API_KEY set, else the
# flow falls back to re-prompts. Per-client channel is selected by the
# tbl_client_custom_properties row "Order Confirmation Mode" = conversation|form.
AI_CONVERSATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_NLU_MODEL=gpt-4o-mini

# Deep Skill Image Auto-Generation (optional — falls back to dall-e-3 when unset)
# Background DALL-E pipeline that creates a catalog thumbnail when an admin
# saves a deep skill without uploading an image. Runtime kill switch lives
# in easyfix_properties.deep_skill.auto_generate_image.enabled — flip to
# 'false' to disable instantly without restarting. Per-image pricing is
# tracked in services/deep-skill-image-gen.service.js (PRICING_USD).
DEEP_SKILL_IMAGE_GEN_MODEL=dall-e-3

# ─── Public customer-form video uploads ──────────────────────────────────
# The public Product Photos/Videos picker (routes/public/job-completion.js)
# accepts photos (5MB cap, 5 per job) AND short videos. These two knobs cap
# video upload size + per-job count so a flood can't blow S3 cost. Defaults
# match the constants in the route file (50MB / 2 videos). Adjust per env.
PUBLIC_VIDEO_MAX_BYTES=52428800
PUBLIC_VIDEO_MAX_PER_JOB=2

# ─── New-CRM menu visibility filter ─────────────────────────────────────
# Some flows in the new CRM (Easyfix_CRM_UI) are still in-progress while the
# legacy Java CRM works fine on the same shared `tbl_menu`. Filtering happens
# inside `services/lookup.service.js::menus()` which only powers the new CRM's
# `/api/shared/lookup/menus` — the legacy CRM reads tbl_menu directly via its
# own DAO and is NOT affected by this allowlist.
#
# Menu-visibility allowlist + override-emails for the new CRM are now managed
# in the `easyfix_properties` table (keys: `new.crm.visible.menu.ids`,
# `new.crm.menu.override.emails`). Run migrations/2026-06-03-easyfix-properties.sql.
#
# ─── WhatsApp via Meta Cloud API (PRIMARY — direct, no BSP) ──────────────
# Used by services/meta.whatsapp.service.js::sendTemplate(). This is the
# active WhatsApp path — orchestrator, otp-delivery, and the admin test
# route all call this. The GALLABOX_* block above is stale and retained
# only as a reversion fallback.
#
# PHONE_NUMBER_ID  — Meta calls this the "Phone Number ID". Found in
#                    Meta Business Manager → WhatsApp → API Setup. NOT the
#                    actual phone number; it's an internal numeric id.
# BUSINESS_ACCOUNT_ID — the WABA id. Not required for sending messages,
#                    but kept here for media + template-management endpoints
#                    we may add later.
# ACCESS_TOKEN     — System User permanent token (recommended) OR a 24h
#                    temporary token (dev only). Needs `whatsapp_business_
#                    messaging` + `whatsapp_business_management` scopes.
# API_VERSION      — Graph API version. Default v20.0; bump in sync with
#                    Meta's quarterly version retirements.
# DEFAULT_LANG     — BCP-47 language tag matching the template's approved
#                    language (e.g. "en", "en_US", "hi"). Override per
#                    call via the `languageCode` arg if a single template
#                    is approved in multiple locales.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v20.0
META_WHATSAPP_DEFAULT_LANG=en
# ─── Kaleyra voice (click-to-call + 4-hour report sync) ──────────────────
# KALEYRA_BASE_URL          — voice API root, no trailing slash. Default fine.
# KALEYRA_API_KEY           — single API key, no separate secret. Passed in
#                             the query string as `api_key=` per legacy
#                             contract.
# KALEYRA_CALLING_ENABLED   — set to "true" to actually place outbound calls.
#                             ANY other value (false / unset / empty) →
#                             calls are suppressed, the route logs and
#                             returns a "would have called" success message
#                             but no real call goes out. Voice bridges
#                             aren't notifications, so this is a dedicated
#                             gate distinct from the SMS/WhatsApp/email
#                             NOTIFICATIONS_DISABLE flag.
# KALEYRA_CALLING_CUSTOM_NUMBER — QA-mode flag. When "true", the CRM's
#                             Call dialog prompts the operator for BOTH
#                             "Call From" and "Call To" numbers and sends
#                             them with the click-to-call request. The BE
#                             also requires these inputs in QA mode and
#                             ignores the *_OVERRIDE env vars below so the
#                             UI inputs aren't clobbered. Leave "false" /
#                             unset in dev + prod.
# KALEYRA_CALL_FROM         — DEV-ONLY caller-leg override. If set (and
#                             KALEYRA_CALLING_CUSTOM_NUMBER is NOT true),
#                             every click-to-call uses this number as the
#                             operator's mobile, regardless of the actual
#                             req.user.mobile_no. Leave UNSET in production
#                             so real operators dial from their own lines.
# KALEYRA_CALL_TO           — DEV-ONLY receiver-leg override. Same precedence
#                             rule: only honoured when
#                             KALEYRA_CALLING_CUSTOM_NUMBER is NOT true.
#                             Leave UNSET in production so real customers
#                             receive the call.
#                             Important: set CALL_FROM and CALL_TO to TWO
#                             DIFFERENT numbers — Kaleyra click2call is a
#                             two-leg bridge and can't connect a line to
#                             itself (will refuse with a 400). Each should
#                             be a phone the developer can actually answer
#                             so both legs can be verified.
#
# THREE-TIER PRIORITY (highest first):
#   1. KALEYRA_CALLING_CUSTOM_NUMBER=true               → QA mode (UI prompt)
#   2. KALEYRA_CALL_FROM + KALEYRA_CALL_TO both set     → Dev fixed test pair
#   3. Both unset / blank                               → Production real numbers
# CRON_DISABLED             — set to "true" to skip ALL cron jobs (including
#                             the Kaleyra 4-hour report poller). Server
#                             still runs; just no scheduled tasks register.
#                             Critical in dev so the poller doesn't hammer
#                             the QA-shared Kaleyra endpoint every 4 hours.
KALEYRA_BASE_URL=https://api-voice.kaleyra.com/v1
KALEYRA_API_KEY=
# Voice-call gate is now in the `easyfix_properties` table
# (key: `kaleyra.calling.enabled`). Run migrations/2026-06-03-easyfix-properties.sql.
#
# QA only — leave false in dev + prod.
KALEYRA_CALLING_CUSTOM_NUMBER=false
# DEV ONLY — leave both empty in production AND in QA (where the UI
# prompt above takes precedence).
KALEYRA_CALL_FROM=
KALEYRA_CALL_TO=
# ─── Plivo voice (alternative click-to-call provider, OFF by default) ─────
# Enable per provider via easyfix_properties (key: `plivo.calling.enabled`);
# pick the default with `voice.default.provider`. Run
# migrations/2026-06-17-voice-provider.sql to seed both (Plivo seeded 'false').
# Plivo, unlike Kaleyra, supports live call-status callbacks + hangup.
# PLIVO_AUTH_ID / PLIVO_AUTH_TOKEN — account credentials (HTTP Basic).
# PLIVO_CALLER_ID                  — a Plivo voice-enabled number (the DID the
#                                    bridge dials from).
# PLIVO_CALLBACK_BASE_URL          — PUBLIC base URL of THIS backend (NOT the
#                                    CRM UI) that Plivo calls back on, e.g.
#                                    https://core.easyfix.in — used to build the
#                                    answer/ring/hangup callback URLs.
# PLIVO_ANSWER_TOKEN_SECRET        — HMAC secret for the short-lived callback
#                                    token (falls back to JWT_SECRET if unset).
# PLIVO_CALLING_CUSTOM_NUMBER / PLIVO_CALL_FROM / PLIVO_CALL_TO — same QA/dev
#                                    override semantics as the KALEYRA_* trio.
PLIVO_BASE_URL=https://api.plivo.com/v1
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
PLIVO_CALLBACK_BASE_URL=
PLIVO_ANSWER_TOKEN_SECRET=
PLIVO_CALLING_CUSTOM_NUMBER=false
PLIVO_CALL_FROM=
PLIVO_CALL_TO=
CRON_DISABLED=true
FCM_API_KEY=

# Webhook (used when /api/webhook/* is built)
WEBHOOK_API_KEY=
# WEBHOOK_S3_PRESIGN_TTL_SEC — TTL (seconds) for presigned S3 URLs baked
# into outbound webhook payloads' `jobImage[].image` fields. External
# clients (Decathlon etc.) may pull the image hours after we deliver
# the webhook, so the default is 86400 (24h) — much longer than the
# 300s in-UI default (S3_PRESIGN_TTL_SEC) which re-mints on each render.
# Tune only if a receiver complains about expired links or you want to
# tighten the window for security. Set via services/webhook.service.js
# job-image resolver; ignored when S3 is disabled (falls back to the
# legacy local-filesystem URL under /easydoc/upload_jobs/).
WEBHOOK_S3_PRESIGN_TTL_SEC=86400

# ─── QuickSight session bridge (header button on Home + Manage Jobs) ─────
# Mints an HS256 JWT { session_proof, user_id, exp, iat } that the
# EF-QuickSight Angular app's API server verifies with the SAME secret
# on its side. The secret must match between this backend and the
# QuickSight backend; otherwise tokens are rejected with "invalid
# signature". Source the value from the legacy CRM deploy or your ops
# vault — do NOT invent one here unless you also rotate it on the
# QuickSight side at the same time.
#
# Empty value is safe — the /admin/quicksight/token endpoint returns
# 503 "QuickSight is not configured" and the frontend shows a
# coming-soon page instead of dead-ending the button.
#
# CONFIRMED 2026-05-13 by reading legacy ACD_APIs source: the JWT
# verifier secret is hardcoded as the literal string "esyfixsecret"
# in JwtUtil.java line 30. Same value is used by the SPOC Angular
# dashboard's QuickSight surface. If the standalone EF-QuickSight
# app uses the same engineering team's verifier (highly likely),
# this same value works there too. Try this first; if "Access
# Denied" persists, the issue is whitelisting on the QuickSight
# side, not the signature.
QUICKSIGHT_JWT_SECRET=esyfixsecret
# Base URLs returned alongside the token for ops scripts. The frontend
# already has the NEXT_PUBLIC_*_QUICKSIGHT_URL pair, so these are
# optional — set them only if you want server-side callers to use the
# returned `fullUrl` directly.
QUICKSIGHT_QA_URL=https://uat.easyfix.in
QUICKSIGHT_PROD_URL=https://corporates.core.easyfix.in

# ─── OpenAPI / Swagger documentation ────────────────────────────────
# Strict opt-in: docs at GET /api/docs and GET /api/openapi.json are
# disabled by default in EVERY environment (local + dev + staging +
# production). Flip this to `true` only when you actively want the
# interactive docs UI exposed — typically only on local dev or when
# walking a partner team through the API surface.
#
# When disabled, both routes return 404 (not 403) so the surface
# isn't even advertised. The OpenAPI YAML spec at docs/openapi.yaml
# still ships with the build — it's the UI/JSON-endpoint that's gated.
SWAGGER_ENABLED=false

# Optional: override the "Try it out" base URL in Swagger UI. If
# unset, defaults to http://localhost:<PORT>/api in non-prod, or
# whichever `servers` entry the openapi.yaml lists first in prod.
# Set this when running behind a proxy / load balancer so the UI
# hits the public hostname, not the internal pod URL.
# SWAGGER_PUBLIC_URL=https://staging.easyfix.in/api

# ─── Customer Magic-Link Completion ─────────────────────────────────
# Customer-facing self-serve flow for Unconfirmed Orders. See
# `services/job-magic-link.service.js` + `routes/public/job-completion.js`
# for the full feature. The plan that introduced it is documented in
# `~/.claude/plans/distributed-foraging-perlis.md`.
#
# MAGIC_LINK_CRON_ENABLED (default: false)
#   Strict opt-in. When `true`, the hourly :05 IST cron at
#   `server/scheduler.js` registers and dispatches the WhatsApp magic
#   link to every opted-in client's Unconfirmed jobs that match the
#   eligibility query (24h cooldown + 3-send cap). When `false` or
#   unset, the cron is NOT registered — the magic-link feature still
#   works via the manual "Trigger / Retrigger" button on the
#   Unconfirmed Jobs list, but no automatic dispatch happens.
#
#   Recommended values per environment:
#     local dev   → false   (never accidentally text real customers)
#     QA          → true    (exercise the full automated flow)
#     production  → false   (until ops confirms they're ready to flip)
#
#   To change at runtime: edit the row, restart the BE. The cron
#   gate is evaluated once at scheduler.start(), not per-tick.
#   Now managed in the `easyfix_properties` table
#   (key: `magic.link.cron.enabled`). Run migrations/2026-06-03-easyfix-properties.sql.

# MAGIC_LINK_BASE_URL
#   The customer-facing URL prefix that gets baked into the WhatsApp
#   template (variable {{3}} of `confirm_order`). The magic-link
#   service appends `/job-completion/<token>` to this value. Must
#   point at the CRM_UI Next.js host (which serves the public form
#   page at `src/app/(public)/job-completion/[token]/page.tsx`).
#
#   QA:         https://qa.crm.easyfix.in
#   production: https://crm.easyfix.in    (or whatever the prod CRM_UI host is)
#
#   IMPORTANT: this is the CRM_UI / Next.js host, NOT the legacy
#   `qa.easyfix.in` (Apache+Tomcat). Pointing at the legacy host
#   returns Tomcat 404 because `/job-completion/*` isn't a legacy
#   servlet — verified on QA 2026-05-30. The CRM_UI subdomain (where
#   you already serve /login, the rest of the new Next.js app) is the
#   canonical home for this route handler.
#
#   The host MUST be reachable from the customer's phone browser. If
#   you're behind a corp VPN, customers can't open the link.
MAGIC_LINK_BASE_URL=https://qa.crm.easyfix.in

# CRM_PUBLIC_BASE_URL — base host for the easyfixer profile-update link
# (`/profile-update/<token>`), served by CRM_UI. QA: https://qa.crm.easyfix.in
# · prod: https://crm.easyfix.in. If unset, the code falls back to
# MAGIC_LINK_BASE_URL (same CRM_UI host) then to the prod hardcode — so this
# (or MAGIC_LINK_BASE_URL) MUST be correct on QA, else profile-update links
# silently point at prod.
CRM_PUBLIC_BASE_URL=https://qa.crm.easyfix.in

# ─── In-house URL shortener ─────────────────────────────────────────
# Base URL where short links (`/s/<code>`) resolve. The redirect
# handler lives in routes/public/url-shortener.js and is mounted at
# the Express root. Defaults to MAGIC_LINK_BASE_URL when unset so a
# single-host deploy "just works"; set explicitly only if you want
# short links to live on a different host (e.g. a dedicated short
# domain like `https://efx.in`).
SHORT_URL_BASE=

# MAGIC_LINK_TTL_HOURS (default: 168 = 7 days)
#   How long a signed magic-link JWT remains valid before its `exp`
#   claim trips. Independent of the state-bound expiry — even within
#   the TTL window, the link auto-dies the moment ops confirms the
#   order (job_status moves off 9) because every public endpoint
#   re-checks status. Shortening this means a customer who waits a
#   long time before clicking gets the "expired" page sooner; the
#   trade-off is your patience for slow-responding customers.
# MAGIC_LINK_TTL_HOURS=168

# ── Google Maps keys ──────────────────────────────────────────────
# TWO distinct roles — keep them separate; they are NOT interchangeable.
#
# GOOGLE_MAPS_API_KEY  (server-side, this backend — the ONLY server key)
#   The single server-side (NON-referer) key for EVERY server-to-Google
#   REST call in this backend:
#     - services/maps.service.js → Geocoding + Places Autocomplete (admin
#       maps proxy + the public page's autocomplete/geocode, always proxied
#       through the BE so the key is NEVER shipped to a browser). This file
#       hard-requires the key (503 if missing).
#     - services/pincode-geocode.service.js → pincode-centroid geocoding for
#       the My Orders → Schedule & Assign distance column. If unset, distance
#       km renders as null and the candidate list still works (tier label).
#   Server-to-Google calls send NO Origin/Referer, so a referer-restricted
#   key 403s here (see the "Google API key referer trap" note in CLAUDE.md).
#   ONE physical key serves both surfaces. Restrict on GCP to: App
#   Restrictions = None (or server egress IP) + API restrictions = Geocoding
#   + Places only.
GOOGLE_MAPS_API_KEY=
#
# GOOGLE_MAPS_API_KEY_PUBLIC  (browser Maps-JS key for the PUBLIC page)
#   The ONLY key shipped to a customer's tab — and ONLY via the
#   token-gated GET /api/public/maps/config (a visitor without a valid
#   magic-link JWT can't even fetch it). It loads the Maps JS <script>
#   on the customer Job-Completion page. DO NOT reuse the CRM's
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY here — that key is for the internal
#   CRM domain; the public surface gets its own dedicated, separately-
#   budgeted key. A Maps-JS key is always visible in the page once
#   loaded, so SECURITY = GCP restrictions, not hiding it: restrict on
#   GCP to App Restrictions = HTTP referrers (https://qa.crm.easyfix.in/*
#   + https://crm.easyfix.in/*) + API restrictions = Maps JavaScript API
#   only + a low budget alert. If unset, the public map degrades to
#   "Map unavailable" and the address form still works.
GOOGLE_MAPS_API_KEY_PUBLIC=
#
# (The CRM's own browser Maps-JS key lives in the FRONTEND env as
#  NEXT_PUBLIC_GOOGLE_MAPS_API_KEY — referer-restricted to the CRM and
#  baked into the CRM bundle at build. It is intentionally NOT used by
#  the public page.)

# ── Technician-app KYC (3rd-party verification proxy) ───────────────
# SUREPASS_VERIFICATION_KEY
#   ONE Bearer token used server-side for ALL KYC vendor calls proxied by
#   services/mobile-kyc.service.js: SurePass DigiLocker (kyc-api.surepass.io)
#   + aadhaarkyc.io PAN-OCR / Aadhaar-OTP / bank-verify / UPI-verify. The
#   legacy Flutter app embedded this key client-side; it now lives ONLY here
#   (never shipped to the app). When unset, every /api/mobile/kyc/* verify
#   endpoint returns a clean 503 "KYC verification is not configured".
SUREPASS_VERIFICATION_KEY=

# ── Public backend base URL (email-verification links) ──────────────
# PUBLIC_API_BASE_URL
#   Absolute base URL of THIS backend as reachable from a user's mail client,
#   used to build the email-verification link target
#   `<PUBLIC_API_BASE_URL>/api/public/email-verify/<token>`
#   (services/mobile-email-verify.service.js). When unset, the link falls back
#   to the inbound request origin (protocol + Host header) — fine for dev, but
#   set it explicitly per environment so links are stable behind Nginx/ACA.
PUBLIC_API_BASE_URL=
