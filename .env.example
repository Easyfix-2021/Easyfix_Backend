# EasyFix Backend — environment TEMPLATE (.env.example)
# Copy to .env and fill in real values. Grouped by concern; values are placeholders.

# ─────────────────────────────────────────────────────────────
# Server & Runtime
# ─────────────────────────────────────────────────────────────
PORT=5100
NODE_ENV=development
LOG_LEVEL=debug
LOG_OPTIONS=false
CRON_DISABLED=true

# ENVIRONMENT — which deployment this process IS. Set per HOST by the compose
# files (deploy/docker-compose.yml → "qa", docker-compose.prod-backend.yml →
# "production"); this local value covers laptop dev.
#
# It is not cosmetic: it is the gate on destructive, environment-specific jobs.
# The QA database refresh registers its cron and runs ONLY when this is exactly
# "qa", and refuses otherwise (services/qa-db-refresh.service.js). It also labels
# ops alert emails so a QA alert is never mistaken for a production one.
#
# KEEP THIS "local" ON A DEV MACHINE. A local .env typically points DB_HOST at
# the shared QA database, so setting it to "qa" here would let a laptop drop and
# reload the QA schema that everyone else is testing against.
ENVIRONMENT=local
SWAGGER_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Application URLs
# ─────────────────────────────────────────────────────────────
CRM_URL=http://localhost:5180
CRM_PUBLIC_BASE_URL=https://qa.crm.easyfix.in
CLIENT_URL=http://localhost:5181
MOBILE_APP_URL=http://localhost:5182,capacitor://localhost,ionic://localhost
MAGIC_LINK_BASE_URL=https://qa.crm.easyfix.in
SHORT_URL_BASE=
PUBLIC_API_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_NAME=easyfix_core
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=100
DB_MAX_IDLE=20
DB_IDLE_TIMEOUT=60000
DB_CONNECT_TIMEOUT=30000

# ─────────────────────────────────────────────────────────────
# Authentication (JWT)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=30d

# ─────────────────────────────────────────────────────────────
# Field-level encryption (lib/field-crypto.js)
# ─────────────────────────────────────────────────────────────
# Two variables, and only ONE of them is a secret. ONE IS REQUIRED
# (EASYFIX_FIELD_ENC_KEY) and one is OPTIONAL (the recovery public key). They
# protect tbl_user_personal_details.bank_account_number and .bank_account_name,
# plus the same two values inside
# tbl_user_profile_update_request.changes / .old_values.
#
# HOW A VALUE IS STORED, because the two variables only make sense together:
# each value gets its own random 32-byte DATA KEY. The value is encrypted under
# that data key; the data key is then WRAPPED under EASYFIX_FIELD_ENC_KEY — the
# normal read path — and, IF a recovery public key is configured, ALSO sealed to
# it as a break-glass path. Re-keying rewrites only a 32-byte data key, never the
# value, which is what makes a rotation cheap and safe to interrupt.
#
# WITH a recovery key: two independent doors to the same value.
# WITHOUT one (this deployment — see below): ONE door. That is the operational
# key, and there is no second one.

# ─── 1. EASYFIX_FIELD_ENC_KEY — THE ONE SECRET ────────────────────────────
# The operational AES-256-GCM key. Used for both encrypt and decrypt. There is
# no second secret and no retired-key list.
#
# 32 RAW BYTES, BASE64-ENCODED (44 characters ending in '='). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ⚠ FAIL-CLOSED, NOT OPTIONAL. Unset, short or malformed, every bank read and
#   write is REFUSED — there is no plaintext fallback anywhere in the code. That
#   is deliberate: an outage is noticed and fixed by setting this variable, a
#   silent plaintext fallback is noticed never and the rows written during the
#   window stay readable forever. Leaving this blank does not "disable
#   encryption", it disables bank details.
#
# ⚠ WITH NO RECOVERY KEY CONFIGURED — WHICH IS HOW THIS SYSTEM RUNS TODAY —
#   LOSING THIS KEY IS FATAL TO THE ENCRYPTED VALUES. They are unreadable and
#   NOTHING recovers them: not a backup of the database (the ciphertext is in
#   the backup, the key is not), not a support ticket, not this repository.
#   Back it up the way you would back up something irreplaceable, keep it where
#   JWT_SECRET is kept, and NEVER in the database — a key stored beside the
#   ciphertext protects nothing.
#
#   A LEAK IS A COMPLETELY DIFFERENT PROBLEM AND IT IS FULLY HANDLED. If this key
#   is exposed, rotate it: Admin Actions → Re-Key Encrypted Fields → mode=rotate.
#   Every data key is unwrapped with the current key and re-wrapped under the new
#   one, the values themselves are never re-encrypted and NEVER EXIST IN THE
#   CLEAR at any point in the process, and the run is safe to interrupt and
#   re-run. Rotation needs no recovery key and asks for nothing but the new key.
#
#   So the risk of running with one key is LOSS, not exposure. Guard the backup.
#
# ⚠ IT MUST BE THE SAME VALUE ON EVERY REPLICA of one environment, and DIFFERENT
#   between QA and Production. Two replicas with different keys means half the
#   reveals fail at random; a shared key means a QA dump decrypts prod values.
EASYFIX_FIELD_ENC_KEY=

# ─── 2. EASYFIX_FIELD_RECOVERY_PUBLIC_KEY — OPTIONAL, AND BLANK EVERYWHERE ─
#
# ⚠ DEPLOYMENT DECISION (owner, 2026-09-01): RUN WITH ONE KEY. No recovery
#   keypair is configured — this variable is blank in local .env, blank in QA
#   and blank in Production, and no key is registered in the database either.
#   Nothing is broken and nothing is half-finished; this is the chosen setup.
#   Bank details read and write normally, and the boot log states the situation
#   once at INFO rather than warning about it on every restart.
#
#   WHAT THAT MEANS, PLAINLY. Each value is encrypted under a per-value data key
#   and that data key is wrapped under EASYFIX_FIELD_ENC_KEY and nothing else.
#   The envelope records the absence honestly, as a '-' where the recovery
#   fingerprint would be and an empty sealed field:
#       v2:<op_fp>:-:<dek_iv>:<dek_tag>:<dek_ct>::<iv>:<tag>:<ct>
#
#     LOSING the operational key  → THE VALUES ARE UNREADABLE, PERMANENTLY.
#                                   There is no break-glass door, no second key,
#                                   nothing to escalate to. Back it up.
#     LEAKING the operational key → fully handled, no recovery key needed.
#                                   Re-Key Encrypted Fields → mode=rotate
#                                   re-wraps every data key under a new key
#                                   without ever producing a plaintext copy.
#
#   So this decision trades a LOSS risk for one less secret to look after. It
#   does not weaken anything against an attacker.
#
# ⚠ AND IT IS NOT A ONE-WAY DOOR — THIS IS THE PART WORTH KNOWING.
#   A row written today with no seal can be GIVEN one later, using only the
#   OPERATIONAL KEY. No old private key is needed, because there is no old seal
#   to open. If you ever decide you want a break-glass path:
#     1. Admin Actions → Generate Recovery Key  (the private half is generated
#        in YOUR BROWSER, shown once, and never posted to a server)
#     2. save the private half into your notes / password manager
#     3. Re-Key Encrypted Fields → mode=seal
#   Step 3 walks every existing row, unwraps its data key with the operational
#   key and seals it to the new recovery key. Rows written from step 1 onward are
#   sealed automatically. Nothing is re-encrypted, the run is safe to interrupt
#   and re-run, and NOTHING IS PASTED — mode=seal asks for no key material at
#   all.
#
#   The one condition: the OPERATIONAL KEY MUST STILL WORK. Retro-protection is
#   available for exactly as long as you can still read the data. It is a door
#   you can open later, not one you can open after the fire.
#
#   WHY THE DATABASE RATHER THAN HERE, if you do register one: rotating a
#   recovery key must not need a deploy, and a control that needs a release train
#   is a control that gets deferred. Registering through the UI also means the
#   PRIVATE half is generated in the operator's BROWSER and never travels to a
#   server at all — whereas producing a value for this variable means generating
#   the pair somewhere and copying half of it around. The database row wins over
#   this variable whenever both exist.
#
#   DO NOT PUT A RANDOM STRING HERE. It is parsed as a PEM public key and will
#   throw — and a CONFIGURED-but-broken recovery key REFUSES every write, because
#   "you set one and it does not work" is a fault, not a decision. Blank is the
#   supported state; garbage is a build that looks broken. If you have already
#   done it, blank the value.
#
# ─── (reference) WHAT THIS VARIABLE IS, IF YOU DO SET IT ──────────────────
# The recovery PUBLIC key: an RSA public key in PEM, base64'd to a single line.
#
# ⚠ THIS IS A PUBLIC KEY. YOU HAVE NOT BEEN HANDED A SECOND SECRET TO GUARD.
#   It is safe in this file, in git, in a config map, in a screenshot, in a
#   ticket. It can only SEAL. Nothing that has it can decrypt anything, which is
#   exactly why it is allowed to live on a server at all.
#
#   The matching PRIVATE key is the master recovery key. It lives in the owner's
#   personal notes and NOWHERE ELSE — not in this file, not in env, not in the
#   database, not on any server, not in a chat message. If it is ever pasted
#   into this variable the application REFUSES to start writing and tells you to
#   treat that key as compromised. That refusal exists because Node will happily
#   derive a public key from a private one, so without it the mistake would just
#   silently work.
#
# ⚠ IT IS NOT REQUIRED FOR WRITES — that is the 2026-09-01 change. With no
#   recovery key resolvable, writes SUCCEED and produce the unsealed envelope
#   described above. Reads never needed it and still do not.
#
#   The one exception, and it is not a loophole: a recovery key that is SET and
#   UNUSABLE (unparseable, wrong type, under 2048-bit, or the private half)
#   refuses every write, exactly as before. Optional means "you may leave it
#   blank", never "we will carry on without the seal we were told to apply".
#
# ─── GENERATING THE RECOVERY KEYPAIR (the owner does this, once) ──────────
# Preferred: the admin UI generates it IN THE BROWSER and only ever POSTs the
# public half, so the private key is never transmitted anywhere. If you are
# doing it by hand instead, do it on a machine you trust and NOT on a server:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out recovery-private.pem
#   openssl rsa -pubout -in recovery-private.pem -out recovery-public.pem
#   base64 -i recovery-public.pem | tr -d '\n'          # ← paste into the var below
#
# Then put recovery-private.pem into your password manager / notes, verify you
# can read it back, and DELETE IT FROM DISK:
#   rm -P recovery-private.pem          # macOS;  shred -u on Linux
#
# 4096-bit because this key is never rotated on a schedule and must outlive the
# data it protects; the only cost is ~340 characters per stored value, in a
# column already sized for it. 2048 is the enforced minimum and anything smaller
# is refused.
EASYFIX_FIELD_RECOVERY_PUBLIC_KEY=

# ─── ROTATING THE OPERATIONAL KEY (do these in order) ─────────────────────
#   1. Generate the new key and keep it in front of you:
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   2. Copy the CURRENT value of EASYFIX_FIELD_ENC_KEY somewhere safe. You are
#      about to overwrite it and step 4 needs it.
#   3. Rewrap the existing rows to the new key: Admin Actions → Secrets Manager
#      → Re-Key Encrypted Fields → mode=rotate, paste the NEW key. It asks for
#      nothing else — the key the process is running with is what unwraps each
#      data key, and NO RECOVERY KEY IS INVOLVED, so this works exactly the same
#      on a deployment that has never had one. Nothing is re-encrypted; only each
#      row's 32-byte data key is re-wrapped, so the run is safe to interrupt and
#      safe to re-run. Do the dry run first — it reports how many rows and takes
#      no key at all.
#   4. Set EASYFIX_FIELD_ENC_KEY = the NEW key on EVERY replica at once, then
#      restart. Between step 3 finishing and this, reads of protected fields
#      fail: the rows want the new key and the process still holds the old one.
#      That window is the cost of keeping exactly one key in env.
#   5. Verify: open one employee's bank details written BEFORE the rotation, then
#      save a change and re-open it. Both must work.
#
#   ⚠ WITH NO RECOVERY KEY, DO NOT SKIP STEP 3 AND DO NOT LOSE THE OLD KEY
#     BEFORE IT FINISHES. Rows still on the old key fail with
#     FIELD_KEY_NOT_IN_RING, and the ONLY thing that can fix them is the old key
#     — there is no master key to fall back on. Keep step 2's copy until step 5
#     passes. (With a recovery key configured, this is merely inconvenient:
#     mode=recover repairs it.)
#
# ─── ROTATING THE RECOVERY KEY ────────────────────────────────────────────
#   NEVER HAD ONE (this deployment) → nothing to rotate. Register one and run
#   mode=seal to bring existing rows under it; see section 2 above.
#   LEAKED, and you still hold it → re-seal. The old private key unseals each
#   data key and re-seals it to the new public key, after which the leaked key is
#   worthless. This is a mode of the same bulk re-key action.
#   LOST, and you do not hold it → existing SEALED rows cannot be re-sealed; that
#   needs the key you lost. New rows use the new key. Those old rows keep the old
#   seal. THE DATA IS NOT LOST — the operational key still reads it perfectly.
#   Do not tell yourself "rotated" and stop worrying: only the second case makes
#   the old key harmless.
#
# ─── IF A READ FAILS WITH FIELD_KEY_NOT_IN_RING ───────────────────────────
# The error names BOTH fingerprints: the operational key the row was written
# under, and the recovery key it is sealed to — or '-' where that would be, which
# means the row was written with no recovery key and HAS NO SECOND DOOR.
# That row was written under a key this process does not hold, so:
#   rec_fp is a fingerprint → restore that operational key, or break-glass:
#     node scripts/field-recover.js inspect '<envelope>' --key-file recovery-private.pem
#   rec_fp is '-'           → RESTORE THAT OPERATIONAL KEY. It is the only thing
#                             that opens the row; there is nothing to break into.
# It is a configuration fault, not corruption — the data is intact.
# Print the fingerprint of a key you are holding, to check whether it is the one:
#   node -e "console.log(require('crypto').createHash('sha256').update(Buffer.from(process.argv[1],'base64')).digest('hex').slice(0,8))" '<base64-operational-key>'
#   openssl pkey -pubin -in recovery-public.pem -outform DER | shasum -a 256 | cut -c1-8

# ─────────────────────────────────────────────────────────────
# File Storage & AWS S3
# ─────────────────────────────────────────────────────────────
UPLOAD_ROOT_PATH=/var/www/html/easydoc
UPLOAD_EASYFIXER_DOCS=/var/www/html/easydoc/easyfixer_documents
UPLOAD_JOB_FILES=/var/www/html/easydoc/upload_jobs
UPLOAD_INVOICES=/var/www/html/easydoc/client_invoice
FILE_BASE_URL=/easydoc
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Shared secret guarding GET /api/internal/job-image-url. The legacy Java CRM's
# /resolveJobImage action sends it as the X-Internal-Resolve-Secret header to
# resolve a stored tbl_job_image.image value into a (presigned S3 / local) URL.
# Leave blank to disable the endpoint (returns 503). Must match the CRM's
# AppConfig imageResolveSecret property.
INTERNAL_IMAGE_RESOLVE_SECRET=
S3_PRESIGN_TTL_SEC=300
WEBHOOK_S3_PRESIGN_TTL_SEC=86400
# Notice-board images only. Longer than the 300s default because these URLs are
# embedded in the /admin/notices/active payload, which the CRM holds in React
# state — the URL starts ageing on dashboard load and may not be requested until
# the operator scrolls to the attachment. At 300s that reliably 403'd with
# "Request has expired" (observed in production 2026-08-14). Kept separate from
# S3_PRESIGN_TTL_SEC because that one also covers client documents and job
# supporting files, where a short window is a deliberate PII posture.
S3_NOTICE_PRESIGN_TTL_SEC=3600
S3_MIGRATE_LEGACY_TO_S3=false

# ─────────────────────────────────────────────────────────────
# Email (Microsoft Graph)
# ─────────────────────────────────────────────────────────────
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=ithelpdesk@easyfix.in

# ─────────────────────────────────────────────────────────────
# Microsoft 365 mailbox provisioning (same app registration as above)
# All OPTIONAL and left COMMENTED on purpose: the feature is gated by
# easyfix_properties['entra.provisioning.enabled'] (default 'false'), and the
# properties table is the preferred home for these — the env vars below are
# only a bootstrap fallback for a host whose property row is still empty.
# Requires Application permissions User.ReadWrite.All + Organization.Read.All
# with admin consent. Full click-path: docs/ENTRA_PROVISIONING.md
# ─────────────────────────────────────────────────────────────
# Licence SKU part number, e.g. O365_BUSINESS_ESSENTIALS / SPB / EXCHANGESTANDARD.
# Property equivalent (wins): entra.provisioning.sku.part.number
#MS_GRAPH_LICENSE_SKU_PART_NUMBER=
# Comma-separated domains this tenant owns. Property equivalent (wins): entra.managed.domains
#MS_GRAPH_MANAGED_DOMAINS=easyfix.in
# ISO-3166 alpha-2 usageLocation stamped on new accounts — Entra refuses some
# licence assignments without it.
#MS_GRAPH_USAGE_LOCATION=IN
# Per-request Graph timeout in ms (default 15000).
#MS_GRAPH_TIMEOUT_MS=15000
# How long POST /api/admin/users waits for mailbox provisioning before letting it
# finish in the BACKGROUND (default 20000). Keep it well under the reverse-proxy
# idle timeout (nginx / Azure Container Apps ~60s): the worst path is 5 sequential
# Graph calls at MS_GRAPH_TIMEOUT_MS each, and a 504 there would report "Add User
# failed" for a user that was in fact created.
#ENTRA_PROVISION_INLINE_TIMEOUT_MS=20000

# ─────────────────────────────────────────────────────────────
# SMS
# ─────────────────────────────────────────────────────────────
SMS_API_URL=http://smscountry.com/SMSCwebservice_Bulk.aspx
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=EsyFix
# Optional Android SMS Retriever hash for technician login OTPs only. Enable
# only after the hash from the production signing certificate is confirmed AND
# the hash-suffixed SMS body is DLT-approved. Exactly 11 base64 characters;
# enabled messages fail closed above 140 UTF-8 bytes and force one bounded SMS
# attempt alongside WhatsApp even when admin single-channel mode is selected.
TECHNICIAN_SMS_RETRIEVER_APP_HASH=

# ─────────────────────────────────────────────────────────────
# WhatsApp (Gallabox / Meta)
# ─────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=gallabox
GALLABOX_URL=https://server.gallabox.com/devapi/messages/whatsapp
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID=
GALLABOX_WEBHOOK_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v20.0

# Our OWN WhatsApp Business number(s), as they appear in a webhook's `from`.
# Comma-separated; any spelling works (+91…, 91…, bare 10 digits) — matched on
# the last 10 digits. NOT the same as GALLABOX_CHANNEL_ID (an opaque Gallabox
# ObjectId) or META_WHATSAPP_PHONE_NUMBER_ID (Meta's internal numeric id);
# this is the dialable number itself.
#
# Gallabox posts events about OUR OWN outbound messages to the inbound webhook,
# and those carry a `from` of this number. Setting this lets the webhook tell
# them apart from customer replies — 9,631 such events in one production week,
# 67% of everything on that endpoint, each logging a "CONTENT NOT FOUND"
# warning asking the reader to widen probes that had nothing to widen.
#
# Leave BLANK and behaviour is exactly as before: any sender counts as a
# customer, so no reply can ever be misclassified — only the log stays noisy.
WHATSAPP_BUSINESS_NUMBER=
META_WHATSAPP_DEFAULT_LANG=en
OTP_DUAL_CHANNEL_MOBILE=true
WHATSAPP_OTP_TEMPLATE=login_otp

# ─────────────────────────────────────────────────────────────
# Push Notifications (FCM — HTTP v1)
# ─────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# Auto-Assignment & Candidate Ranking
# ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=5
MAX_TRAVEL_DISTANCE_KM=15
WEIGHT_COMPLETION=0.15
WEIGHT_DISTANCE=0.35
WEIGHT_RATING=0.20
WEIGHT_WORKLOAD=0.30

# ─────────────────────────────────────────────────────────────
# Voice — Kaleyra
# ─────────────────────────────────────────────────────────────
KALEYRA_BASE_URL=https://api-voice.kaleyra.com/v1
KALEYRA_API_KEY=
KALEYRA_CALLING_CUSTOM_NUMBER=false
KALEYRA_CALL_FROM=
KALEYRA_CALL_TO=

# ─────────────────────────────────────────────────────────────
# Voice — Plivo (Click-to-Call & Browser Web Call)
# ─────────────────────────────────────────────────────────────
PLIVO_BASE_URL=https://api.plivo.com/v1
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
PLIVO_CALLBACK_BASE_URL=
PLIVO_ANSWER_TOKEN_SECRET=
PLIVO_CALLING_CUSTOM_NUMBER=false
PLIVO_CALL_FROM=
PLIVO_CALL_TO=
PLIVO_WEB_APP_ID=
PLIVO_ENDPOINT_USERNAME=
PLIVO_ENDPOINT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# AI — Realtime Voice (AI Calling / Validate Flows)
# ─────────────────────────────────────────────────────────────
OPENAI_REALTIME_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="alloy"
GEMINI_API_KEY=""
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
GEMINI_VOICE="Autonoe"
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
MAX_CONCURRENT_AI_CALLS="50"
AI_CALL_MAX_DURATION_SEC="300"
AI_CALL_IDLE_SEC="30"

# ─────────────────────────────────────────────────────────────
# AI Teleprompter for Calls (guided, human-led, AI-assisted)
# ─────────────────────────────────────────────────────────────
# Master flag / STT provider / allowlist live in easyfix_properties
# (teleprompter.enabled, stt.provider, teleprompter.emails) — flip via setProperty.
# STT is MANDATORY (next-question + analysis). Either run the stt-service/ sidecar
# separately and set STT_SERVICE_URL, OR set STT_AUTOSTART=true to have the server
# launch + supervise it (model loads once; the URL is advertised only when ready).
STT_AUTOSTART="false"
STT_SIDECAR_PORT="8300"
STT_MODEL="small"
STT_PYTHON="python3"
STT_SERVICE_URL=""
# STT_MEM_LIMIT — docker mem cap for the deployed `stt` container. DEPLOY-MANAGED:
# deploy-stt.yml computes it as a % of the box's RAM and writes it into the server's
# /opt/easyfix/.env. Do NOT set it here (local dev runs STT via the Python venv, not
# a container). Tune via GitHub Variables STT_MEM_PERCENT / STT_MEM_MIN_MB / STT_MEM_MAX_MB.
# STT_OOM_WEBHOOK_KEY — shared secret for the STT OOM-kill alert. SERVER-ONLY: set it
# ONCE in the host's /opt/easyfix/.env; compose injects it into both the backend and
# the stt-oom-watch sidecar. Unset ⇒ OOM alerting is off. Recipients live in
# easyfix_properties('teleprompter.stt.alert.emails'). Not used in local dev.
STT_OOM_WEBHOOK_KEY=""
SOPHY_API_KEY_TELEPROMPTER=""
MAX_CONCURRENT_TELEPROMPTER="50"
TELEPROMPTER_MAX_DURATION_SEC="1200"
TELEPROMPTER_IDLE_SEC="60"
TELEPROMPTER_CONNECT_TIMEOUT_SEC="120"

# ─────────────────────────────────────────────────────────────
# AI — Sophy Text Gateway (text-only LLM; per-feature keys)
# ─────────────────────────────────────────────────────────────
SOPHY_BASE_URL="https://sophy.in/v1"
SOPHY_API_KEY_AI_CALLING="mw_live_xxxxxxxx"
SOPHY_API_KEY_SKILL_MATRIX="mw_live_xxxxxxxx"
SOPHY_API_KEY_CALL_ANALYSIS="mw_live_xxxxxxxx"
# Aadhaar OCR — POST /api/mobile/kyc/aadhaar-ocr sends the technician's FRONT +
# BACK Aadhaar photos to Sophy for field extraction (VISION request: the images
# ride as base64 image_url parts). This key must be pointed at a VISION-CAPABLE
# model in Sophy — a text-only key makes every request fail and the endpoint
# permanently reports available:false. Unset ⇒ the feature is simply disabled
# (200 with available:false); no fallback to any other feature's key.
SOPHY_API_KEY_AADHAAR_OCR="mw_live_xxxxxxxx"

# ─────────────────────────────────────────────────────────────
# AI — Call Analysis in RECORDING mode (Gemini direct)
# ─────────────────────────────────────────────────────────────
# Scoring a call from its AUDIO instead of Plivo's ASR text. Sophy is text-only
# and physically cannot carry audio, so this leg calls Google AI Studio direct
# and reuses the GEMINI_API_KEY above. No key ⇒ recording mode is simply
# unavailable and everything falls back to the transcript. The mode + model id
# live in easyfix_properties (call.analysis.mode / call.analysis.gemini.model),
# not here, so ops can switch them without a redeploy.
# Both settings below are OPTIONAL — sane defaults are in code.
GEMINI_HTTP_TIMEOUT_MS="45000"
# Raw audio ceiling for the inline-base64 request (base64 inflates 4/3 against
# Gemini's ~20MB request limit; our recordings are stereo, so double a mono call).
GEMINI_MAX_INLINE_AUDIO_BYTES="14680064"

# ─────────────────────────────────────────────────────────────
# AI — Conversation, NLU & Deep-Skill Images
# ─────────────────────────────────────────────────────────────
AI_CONVERSATION_ENABLED=false
# The WhatsApp conversation NLU routes through SOPHY (services/ai.service.js), not
# OpenAI directly — its own per-feature mw_live_ key, like the other SOPHY_API_KEY_*
# entries above. Both AI_CONVERSATION_ENABLED=true AND this key are required; with
# either missing the flow degrades to plain re-asks instead of failing.
SOPHY_API_KEY_CONVERSATION="mw_live_xxxxxxxx"
# Superseded by SOPHY_API_KEY_CONVERSATION (2026-07-30) — the direct-to-OpenAI NLU
# path was removed. Kept listed only so an existing .env that still sets these is
# recognisably stale; they are no longer read.
# OPENAI_API_KEY_CONVERSATION=
# OPENAI_NLU_MODEL=gpt-4o-mini
OPENAI_API_KEY_DEEPSKILL_IMAGE=
DEEP_SKILL_IMAGE_GEN_MODEL=dall-e-3

# ─────────────────────────────────────────────────────────────
# AWS Transcribe (Call Metrics)
# ─────────────────────────────────────────────────────────────
TRANSCRIBE_DATA_ACCESS_ROLE_ARN=

# ─────────────────────────────────────────────────────────────
# Google Maps (Geocoding / Places)
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_PUBLIC=

# ─────────────────────────────────────────────────────────────
# Identity Verification (Surepass)
# ─────────────────────────────────────────────────────────────
# The BARE token — do NOT include a "Bearer " prefix; the service adds it.
# (A pasted "Bearer <token>" is stripped defensively, so both forms work.)
SUREPASS_VERIFICATION_KEY=

# ─────────────────────────────────────────────────────────────
# Webhooks
# ─────────────────────────────────────────────────────────────
WEBHOOK_API_KEY=

# ─────────────────────────────────────────────────────────────
# Public Video Upload Limits
# ─────────────────────────────────────────────────────────────
PUBLIC_VIDEO_MAX_BYTES=52428800
PUBLIC_VIDEO_MAX_PER_JOB=2

# ─────────────────────────────────────────────────────────────
# Testing & QA Overrides
# ─────────────────────────────────────────────────────────────
NOTIFICATIONS_DISABLE=false
TEST_EMAILS=
TEST_MOBILE=
TEST_FCM_TOKEN=
QA_DETERMINISTIC_OTP=true
ENABLE_DEV_PROFILE_URL=true

# ─────────────────────────────────────────────────────────────
# READ REPLICA (optional — db-read.js)
# ─────────────────────────────────────────────────────────────
# UNSET = every read uses the primary. That is the safe default and what a
# laptop or a QA box should do; the split is opt-in per environment.
#
# The replica is an OPTIMISATION, never a DEPENDENCY. A read that cannot reach
# it is retried on the primary, so an outage costs throughput and nothing else.
# A circuit breaker stops a dead replica from taxing every read with a connect
# timeout — which would make an outage feel SLOWER than having no replica.
#
# HOW TO TELL IT IS ACTUALLY BEING USED — this is the part that matters:
#   curl -s https://backend.easyfix.in/api/health/db | python3 -m json.tool
# Look at `replica.reads`. If it stays 0 under real traffic, nothing is using
# the replica and the split is a silent no-op. Also check
# `replica.distinctFromPrimary`: false means DB_READ_HOST resolves to the SAME
# MySQL server as the primary, which passes every health check while shedding
# no load at all.
#
# Credentials fall back to the primary's DB_USER / DB_PASSWORD / DB_NAME when
# omitted, so pointing at a replica normally needs only DB_READ_HOST. Grant
# that user SELECT (and SHOW VIEW) only.
DB_READ_HOST=
DB_READ_PORT=
DB_READ_NAME=
DB_READ_USER=
DB_READ_PASSWORD=
# Smaller than the primary's on purpose: a runaway report should exhaust its
# own pool, not the database's max_connections.
DB_READ_CONNECTION_LIMIT=10
# Short, because this connect sits in front of a fallback and must fail fast.
DB_READ_CONNECT_TIMEOUT=5000
DB_READ_BREAKER_THRESHOLD=3
DB_READ_BREAKER_COOLDOWN_MS=30000

# ─────────────────────────────────────────────────────────────
# QA DB Refresh from Production (QA ONLY — services/qa-db-refresh.service.js)
# ─────────────────────────────────────────────────────────────
# Reloads the QA database from production on the 1st + 16th at 00:30 IST.
#
# READ THIS BEFORE SETTING ANYTHING:
#  - PROD_SLAVE_DB_HOST must be the production READ REPLICA, never the primary.
#    The primary is then entirely outside the blast radius.
#  - PROD_SLAVE_DB_USER must be a MySQL user granted ONLY
#    SELECT, SHOW VIEW, TRIGGER on the schema, host-restricted to the QA box.
#    The grant — not this config, and not the code — is what makes it impossible
#    for this job to write to production.
#  - There is NO enable flag. The job runs only where ENVIRONMENT=qa (set per
#    host by the compose file) and refuses everywhere else. It also refuses
#    unless the restore target differs from the source. It loads REAL customer
#    contact details into QA — keep TEST_MOBILE / TEST_EMAILS set there, since
#    those per-channel redirects are what stop a QA run reaching a real customer.
#  - Email recipients come from easyfix_properties qa.dbrefresh.alert.emails.
PROD_SLAVE_DB_HOST="10.30.3.73"
PROD_SLAVE_DB_PORT="3306"
PROD_SLAVE_DB_USER="easyfix-user_ro"
PROD_SLAVE_DB_PASSWORD=""
PROD_SLAVE_DB_NAME="easyfix"
# Belt-and-braces: refuse to restore unless DB_HOST is exactly this.
QA_DB_REFRESH_HOST="10.30.2.30"

# Outbound event-webhook switch. Dispatch proceeds UNLESS this is explicitly
# false/0/no — an UNSET variable keeps webhooks ENABLED, so a missed env file
# can never silently stop production callbacks. Keep false everywhere except
# Prod; only Prod should deliver real callbacks to client endpoints.
WEBHOOK_OUTBOUND_ENABLED=false
